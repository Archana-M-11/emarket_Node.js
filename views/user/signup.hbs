<section class="py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm p-4">
          <h3 class="text-center text-success mb-4">
            <i class="bi bi-person-plus-fill me-2"></i>Create New Account
          </h3>

          <form action="/signup" method="POST">
            <!-- Name -->
            <div class="mb-3">
              <label class="form-label">Name</label>
              <input 
                type="text" 
                class="form-control" 
                name="Name" 
                placeholder="Enter your name"
                required>
            </div>

            <!-- Email -->
            <div class="mb-3">
              <label class="form-label">Email Address</label>
              <input 
                type="email" 
                class="form-control" 
                name="Email" 
                placeholder="Enter your email"
                required>
            </div>

            <!-- Password -->
            <div class="mb-3">
              <label class="form-label">Password</label>
              <input 
                type="password" 
                class="form-control" 
                name="Password" 
                placeholder="Create a password"
                required>
            </div>

            <!-- Link and Button -->
            <div class="d-flex justify-content-between align-items-center mt-3">
              <a href="/login" class="text-decoration-none">Already have an account?</a>
              <button type="submit" class="btn btn-success px-4">
                <i class="bi bi-check2-circle me-1"></i>Signup
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
