<section>
  <div class="container py-5">
    <div class="row g-4">
      {{#each products}}
      <div class="col-sm-6 col-md-4 col-lg-3">
        <div class="card shadow-sm h-100 border-0">
          <img src="/product-images/{{this._id}}.jpg" class="card-img-top" alt="{{this.Name}}" style="height: 15rem; object-fit: cover;">
          <div class="card-body d-flex flex-column justify-content-between">
            <div>
              <h5 class="card-title fw-bold text-truncate">{{this.Name}}</h5>
              <p class="card-subtitle text-muted mb-1">{{this.Category}}</p>
              <p class="card-text text-success fw-semibold">₹{{this.Price}}</p>
              <p class="card-text small text-secondary">{{this.Description}}</p>
            </div>
            <button class="btn btn-outline-primary mt-3" onclick="addToCart('{{this._id}}')">
              <i class="bi bi-cart-plus me-1"></i> Add to Cart
            </button>
          </div>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
