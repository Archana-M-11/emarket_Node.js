<section class="container mt-5">
  <div class="row justify-content-center">
    {{#each products}}
    <div class="col-md-3 mb-4">
      <div class="card">
        <img
          class=""
          src="/product-images/{{item}}.jpg"
          alt="Product Image"
          style="height: 12rem;"
        />
        <div class="card-body d-flex flex-column justify-content-between">
          <div>
            <h5 class="card-title text-primary fw-semibold">{{this.Name}}</h5>
            <p class="card-text mb-1"><strong>Rs.</strong> {{this.Price}}</p>
            <p class="card-text mb-1"><strong>Quantity:</strong> {{this.quantity}}</p>
            <p class="card-text text-muted" style="font-size: 0.9rem;">{{this.Description}}</p>
          </div>
        </div>
      </div>
    </div>
    {{/each}}
  </div>
</section>
