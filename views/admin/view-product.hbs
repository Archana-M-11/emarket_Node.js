<section>
  <div class="container my-5">
    <!-- Add Product Button -->
    <div class="row mb-3">
      <div class="col text-end">
        <a href="/admin/add-product" class="btn btn-success shadow-sm">
          <i class="bi bi-plus-circle me-1"></i> Add Product
        </a>
      </div>
    </div>

    <!-- Product Table -->
    <div class="table-responsive">
      <table class="table table-hover align-middle table-bordered shadow-sm" id="productsTable">
        <thead class="table-dark">
          <tr>
            <th scope="col">No</th>
            <th scope="col">Name</th>
            <th scope="col">Category</th>
            <th scope="col">Price</th>
            <th scope="col">Description</th>
            <th scope="col">Image</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each products}}
          <tr>
            <th scope="row">{{@index}}</th>
            <td>{{this.Name}}</td>
            <td>{{this.Category}}</td>
            <td>₹{{this.Price}}</td>
            <td>{{this.Description}}</td>
            <td>
              <img src="/product-images/{{this._id}}.jpg" alt="Product Image" class="img-thumbnail" style="max-width: 100px;">
            </td>
            <td>
              <a href="/admin/edit-product/{{this._id}}" class="btn btn-sm btn-primary me-1">
                Edit
              </a>
              <a href="/admin/delete-product/{{this._id}}" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure to delete {{this.Name}}?')">
                Delete
              </a>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</section>
<script>
  $(function(){
    $('#productsTable').DataTable();
  })
</script>